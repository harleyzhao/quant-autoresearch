{
  "name": "@arbor/core",
  "version": "0.0.1",
  "type": "module",
  "description": "Arbor growth kernel: self-organizing tree growth, pipe-model radii, phenology, meshing. No DOM dependencies.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "metrics": "npx --yes tsx@4 scripts/metrics.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
