    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/three": "^0.185.4",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  }
}
