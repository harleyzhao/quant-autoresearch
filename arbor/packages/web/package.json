{
  "name": "@arbor/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Arbor web viewer: three.js + Tweakpane front end for the @arbor/core growth kernel.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
